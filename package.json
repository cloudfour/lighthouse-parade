{
  "name": "lighthouse-parade",
  "version": "2.1.0",
  "description": "A Node.js command line tool that crawls a domain and compiles a report with lighthouse performance data for every page.",
  "license": "MIT",
  "repository": "cloudfour/lighthouse-parade",
  "author": "emerson@cloudfour.com",
  "type": "module",
  "bin": "./dist/src/cli.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "check-lint": "eslint . && prettier --check .",
    "lint": "eslint --fix . && prettier --write .",
    "type": "tsc --noEmit",
    "type:watch": "tsc --watch --noEmit",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "changeset": "changeset",
    "version": "changeset version && prettier --write .",
    "release": "npm run build && changeset publish"
  },
  "files": [
    "dist/src/*.js"
  ],
  "dependencies": {
    "csv": "6.6.3",
    "csv-parse": "4.16.3",
    "csv-stringify": "5.6.5",
    "globrex": "0.1.2",
    "kleur": "4.1.5",
    "lighthouse": "9.6.8",
    "log-update": "8.0.0",
    "sade": "1.8.1",
    "sanitize-filename": "1.6.4",
    "simplecrawler": "1.1.9"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@cloudfour/eslint-config": "26.0.0",
    "@types/globrex": "0.1.4",
    "@types/node": "22.20.1",
    "@types/sade": "1.8.0",
    "@types/simplecrawler": "1.1.5",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "timekeeper": "2.3.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "prettier": {
    "singleQuote": true
  }
}
